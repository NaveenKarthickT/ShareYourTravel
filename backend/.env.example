# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
# Get this from Atlas -> Database -> Connect -> Drivers
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/carpool_platform?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/carpool1

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Initial Super Admin (used by npm run seed:superadmin)
SUPERADMIN_EMAIL=superadmin@carpool.com
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_NAME=Platform Super Admin
